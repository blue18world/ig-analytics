# Instagram Analytics — 環境變數設定
# 複製此檔案為 .env，填入真實值後執行 python ig_fetcher.py

# Meta Graph API Token（長期 Token，60天有效）
META_ACCESS_TOKEN=your_long_lived_access_token_here

# IG Business Account ID（固定值，不用改）
META_IG_USER_ID=17841466923315453

# Google Sheets 設定
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account（JSON 格式，貼整個 JSON 字串）
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
